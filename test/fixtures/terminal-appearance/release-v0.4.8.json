      },
      {
        "id": "debug",
        "color": "#5c6470",
        "enabled": true,
        "text": "(?<![\\w-])[dlbcps-][rwxsStT-]{9}[+.]?\n\\b(?:verbose|debug|trace)\\b",
        "mode": "regex",
        "caseSensitive": false
      }
    ]
  }
}
